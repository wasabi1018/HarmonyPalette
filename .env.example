NEXT_PUBLIC_SITE_URL=https://harmonypalette.jp
# Search Consoleの「HTMLタグ」に表示されるcontent属性の値のみを設定します。
GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_secret_key

# Comma-separated email addresses allowed to use /admin.
# A Supabase Auth user with app_metadata.role="admin" is also accepted.
ADMIN_EMAILS=admin@example.com

# Legacy keys used by schedule import and cron integrations.
ADMIN_IMPORT_SECRET=your_long_random_admin_secret
CRON_SECRET=your_long_random_cron_secret
AUTO_PUBLISH_IMPORTS=false
